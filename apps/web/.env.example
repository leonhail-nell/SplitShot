# PostgreSQL connection string (Neon / Vercel Postgres / local Postgres).
# On Vercel, the Neon Marketplace integration sets this automatically.
# Local: copy DATABASE_URL (pooled) + DATABASE_URL_UNPOOLED (direct) from Vercel/Neon.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Direct (non-pooled) URL for prisma migrate — required for Neon.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

ANTHROPIC_API_KEY="sk-ant-..."
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"
# Vercel Blob — required on Vercel for receipt photo storage (auto when you add a Blob store)
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
# Optional settle-up via Stripe Checkout
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
